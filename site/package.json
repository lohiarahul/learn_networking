    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7.2.0",
    "astro-mermaid": "^2.1.0",
    "lucide-astro": "^0.556.0",
    "mermaid": "^11.16.1",
    "sharp": "^0.35.3",
    "starlight-theme-flexoki": "^0.2.3"
  }
