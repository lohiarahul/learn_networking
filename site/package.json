{
  "name": "learn-networking-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tutorial website for the learn_networking course, generated from the Markdown in networking-fundamentals/",
  "scripts": {
    "sync": "node scripts/sync-content.mjs && node scripts/sync-illustrations.mjs",
    "og": "node scripts/gen-og.mjs",
