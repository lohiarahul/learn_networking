---
/**
 * Registers `<kz-checkpoint>`, the mid-lesson recall question.
 *
 * Renders no markup of its own — like Diagram and Predict it only carries the custom-element
 * definition, and is included from Footer.astro so every doc page gets it. sync-content.mjs emits the
 * elements, wrapping a `> **Check yourself —** …` blockquote together with the `<details>` answer
 * written underneath it.
 *
 * Why interleave these at all, when the course already has a `test-yourself.md` per act: batching all
 * the recall at the end of an act is the weakest place to put it. The reader has just read the
 * material, so recall feels easy and tells them nothing; and by then a misunderstanding from lesson
 * two has had four lessons to compound. Two questions inside the lesson, answered before the answer is
 * visible, cost thirty seconds and catch the misunderstanding while it is still cheap.
 *
 * What this element adds over a bare `<details>` — which already gates the answer perfectly well on
 * GitHub — is the grade. Opening the reveal prompts "got it / not yet", and that answer is what builds
 * the review queue on /progress. Without it the checkpoint is a one-shot; with it, the ones you missed
 * come back.
 *
 * No-JS: the blockquote and the `<details>` are untouched and fully usable. Only the grade row is lost.
 */
---

<script>
  import { getGrade, setGrade, type Grade } from '../lib/review';

  class CheckpointBox extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready === 'true') return;
      this.dataset.ready = 'true';

      const details = this.querySelector('details');
      if (!details) return; // a question with no answer written yet — leave it alone

      const index = [...document.querySelectorAll('kz-checkpoint')].indexOf(this);
      const path = location.pathname.endsWith('/') ? location.pathname : `${location.pathname}/`;
      const key = `${path}#${index}`;

      // The question, minus the "Check yourself —" lead, for the review list on /progress.
      const prompt = (this.querySelector('blockquote p')?.textContent ?? '')
        .replace(/^\s*Check yourself\s*[—–-]\s*/i, '')
        .trim();

      const row = document.createElement('div');
      row.className = 'checkpoint__grade not-content';
      row.hidden = true;

      const label = document.createElement('span');
      label.className = 'checkpoint__gradeLabel';
      label.textContent = 'Did you get it?';

      const buttons: Partial<Record<Grade, HTMLButtonElement>> = {};
      const paint = (chosen: Grade | null) => {
        for (const [grade, button] of Object.entries(buttons)) {
          button.setAttribute('aria-pressed', String(grade === chosen));
        }
      };

      for (const [grade, text] of [
        ['got', 'Got it'],
        ['notyet', 'Not yet'],
      ] as Array<[Grade, string]>) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `checkpoint__btn checkpoint__btn--${grade}`;
        button.textContent = text;
        button.setAttribute('aria-pressed', 'false');
        button.addEventListener('click', () => {
          setGrade(key, { path, prompt, grade });
          paint(grade);
        });
        buttons[grade] = button;
        row.append(button);
      }
      row.prepend(label);
      details.after(row);

      // Only ask for a grade once the answer has actually been looked at — grading a question you
      // haven't opened would just be noise in the review queue.
      details.addEventListener('toggle', () => {
        if (details.open) row.hidden = false;
      });

      const existing = getGrade(key);
      if (existing) {
        row.hidden = false;
        paint(existing.grade);
      }
    }
  }

  if (!customElements.get('kz-checkpoint')) customElements.define('kz-checkpoint', CheckpointBox);
</script>
