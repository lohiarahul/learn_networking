---
/**
 * The landing page's one flourish: the course's question, drawn.
 *
 * `write()` on the left, `read()` on the right, one stop per act between them, and a packet crossing
 * the whole distance. The ends are the course's *question*, not its itinerary — the question is
 * answered around Act V and the acts after it are what the answer becomes once a file in one kernel
 * is an object in a fleet's document store, so the rail keeps going.
 *
 * It's the same travelling dot as the section motifs (`Motif.astro`), at the only scale where the
 * whole journey fits — which is the argument for it being here rather than a hero image: it states
 * the thesis instead of decorating it.
 *
 * This one *does* loop. There's exactly one on the site, above the fold, and it's the thing that makes
 * a page of prose feel alive; the per-page motifs stay quiet precisely so this can move.
 *
 * Coordinates are a 360-unit viewBox capped at 30rem, so the type inside it never scales below the
 * ~11px it's drawn at — the mistake with a wide viewBox is that its labels turn to dust on a phone.
 * Ten stops fit that fixed width at a 28-unit pitch, which is why the numerals are set a shade
 * smaller and the stop circles a shade tighter than a five-stop rail would want: `VIII` is the
 * widest numeral in the set and it has to clear its neighbours at phone scale, where one unit is
 * one CSS pixel.
 */
const STOPS = [
  { x: 54, numeral: 'I' },
  { x: 82, numeral: 'II' },
  { x: 110, numeral: 'III' },
  { x: 138, numeral: 'IV' },
  { x: 166, numeral: 'V' },
  { x: 194, numeral: 'VI' },
  { x: 222, numeral: 'VII' },
  { x: 250, numeral: 'VIII' },
  { x: 278, numeral: 'IX' },
  { x: 306, numeral: 'X' },
];

const RAIL = 'M54 22H306';
---

<div class="strip">
  <svg
    viewBox="0 0 360 46"
    role="img"
    aria-label="write() on one machine, through ten acts, to read() on another"
  >
    <text class="strip__end" x="0" y="26">write()</text>
    <text class="strip__end" x="360" y="26" text-anchor="end">read()</text>

    <path class="strip__rail" d={RAIL} />

    {
      STOPS.map((s) => (
        <>
          <circle class="strip__stop" cx={s.x} cy="22" r="3.75" />
          <text class="strip__numeral" x={s.x} y="41" text-anchor="middle">
            {s.numeral}
          </text>
        </>
      ))
    }

    <circle class="strip__packet" r="3.2" cx="0" cy="0" style={`offset-path:path('${RAIL}')`} />
  </svg>
</div>

<style>
  .strip {
    max-width: 30rem;
    margin: 0 auto;
    /* The hero pads above; this pads below. Asymmetric on purpose — the strip has to read as part of
       the hero rather than as the first item of the section under it. */
    padding-block: 0 var(--s-10);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .strip__rail {
    fill: none;
    stroke: var(--sl-color-hairline);
    stroke-width: 1.5;
  }

  .strip__stop {
    fill: var(--sl-color-bg);
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
  }

  .strip__end {
    font-family: var(--kz-font-mono);
    font-size: 11px;
    fill: var(--sl-color-gray-3);
  }

  .strip__numeral {
    font-size: 7.5px;
    font-weight: var(--kz-w-semibold);
    letter-spacing: 0.04em;
    fill: var(--sl-color-gray-3);
  }

  .strip__packet {
    fill: var(--sl-color-text-accent);
    offset-rotate: 0deg;
    animation: strip-run 5s var(--ease-standard) infinite;
  }

  /* The dot rests off-stage for the last fifth of the cycle rather than snapping back, so the loop
     reads as successive packets rather than one pendulum. */
  @keyframes strip-run {
    0% { offset-distance: 0%; opacity: 0; }
    6% { opacity: 1; }
    74% { offset-distance: 100%; opacity: 1; }
    82%, 100% { offset-distance: 100%; opacity: 0; }
  }

  /* No `offset-path` (Safari before 16) means the dot would land at the viewBox origin. Park it on
     the rail instead and let the strip be the static diagram it already is. */
  @supports not (offset-path: path('M0 0H1')) {
    .strip__packet { transform: translate(150px, 22px); animation: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .strip__packet { animation: none; offset-distance: 38%; }
  }
</style>
